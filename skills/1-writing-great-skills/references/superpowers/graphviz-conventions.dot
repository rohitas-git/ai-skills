digraph SKILL_FLOW_STYLE {
  // Provenance-only minimal example. Use diagrams only when they clarify a real branch.
  "Pinned input" [shape=ellipse];
  "Material branch?" [shape=diamond];
  "Apply bounded step" [shape=box];
  "Return evidence" [shape=doublecircle];

  "Pinned input" -> "Material branch?";
  "Material branch?" -> "Apply bounded step" [label="yes"];
  "Material branch?" -> "Return evidence" [label="no"];
  "Apply bounded step" -> "Return evidence";
}

