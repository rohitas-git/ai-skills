#!/usr/bin/env bash
# Resolve the target checkout's local SDD artifact directory. Never overwrite
# an existing ignore file or use a tracked/symlinked artifact location.
set -euo pipefail
umask 077
[ "$#" -eq 0 ] || { echo "usage: sdd-workspace" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
dir="$root/.superpowers/sdd"
for entry in "$root/.superpowers" "$dir" "$dir/.gitignore"; do
  [ ! -L "$entry" ] || { echo "refusing symlinked workspace: $entry" >&2; exit 3; }
done
[ -z "$(git -C "$root" ls-files -- .superpowers/sdd)" ] ||
  { echo "SDD workspace contains tracked files; choose a local artifact location" >&2; exit 3; }

mkdir -p "$dir"
if [ ! -e "$dir/.gitignore" ]; then
  (set -o noclobber; printf '*\n' > "$dir/.gitignore")
fi
git -C "$root" check-ignore -q -- .superpowers/sdd/artifact-probe ||
  { echo "existing SDD ignore rules do not protect artifacts; left unchanged" >&2; exit 3; }
cd "$dir"
pwd -P
