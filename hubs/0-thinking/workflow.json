      "id": "F-T1",
      "question": "Is the right thinking frame already clear?",
      "recommended": "Yes invoke leaf if named; else hub route",
      "branches": [
        "invoke leaf",
        "hub route F-T2",
        "NONE reason direct",
        "Agent judgment"
      ]
    },
    {
      "id": "F-T2",
      "question": "What kind of thinking help?",
      "recommended": "Match problem type (diagnose/decide/create/risk-response)",
      "branches": [
        "diagnose",
        "decide",
        "create",
        "risk and response framing",
        "perspectives and strategy",
        "compose",
        "compare competing plans",
        "Agent judgment"
      ]
    }
