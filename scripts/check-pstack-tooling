#!/usr/bin/env python3
"""Check pinned adopted-tool hashes and optional upstream source hashes without executing tools."""
import argparse
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / 'guidelines/catalog/pstack-tooling-manifest.json'


def contained_file(root, relative):
    path = root / relative
    if Path(relative).is_absolute() or '..' in Path(relative).parts:
        raise ValueError(f'unsafe manifest path: {relative}')
    if path.is_symlink() or not path.is_file() or not path.resolve().is_relative_to(root.resolve()):
        raise ValueError(f'missing, linked or escaped file: {relative}')
    return path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source-root', type=Path, help='optional existing checkout of the pinned pstack directory')
    args = parser.parse_args()
    errors, seen = [], set()
    document = json.loads(MANIFEST.read_text())
    for entry in document['files']:
        relative = entry['destination']
        try:
            if relative in seen:
                raise ValueError(f'duplicate adopted path: {relative}')
            seen.add(relative)
            path = contained_file(ROOT, relative)
            if hashlib.sha256(path.read_bytes()).hexdigest() != entry['adopted_sha256']:
                raise ValueError(f'adopted hash mismatch: {relative}')
            if path.stat().st_mode & 0o777 != entry['adopted_mode']:
                raise ValueError(f'adopted mode mismatch: {relative}')
            if args.source_root and entry.get('source'):
                source = contained_file(args.source_root, entry['source'])
                if hashlib.sha256(source.read_bytes()).hexdigest() != entry['upstream_sha256']:
                    raise ValueError(f'upstream hash mismatch: {entry["source"]}')
        except (OSError, ValueError) as error:
            errors.append(str(error))
    print(json.dumps({'checked_files': len(seen), 'errors': errors, 'scope': 'File integrity only; not behavioral or security proof.'}, indent=2))
    return int(bool(errors))


if __name__ == '__main__':
    raise SystemExit(main())
