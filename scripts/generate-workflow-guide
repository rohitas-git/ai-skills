#!/usr/bin/env python3
"""Generate the task guide from workflow recipes and the existing route metadata."""
import argparse
import json
from pathlib import Path
import runpy

ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / 'guidelines/catalog/daily-workflows.json'
OUTPUT = ROOT / 'guidelines/catalog/daily-workflows.md'


def render():
    routes = runpy.run_path(str(ROOT / 'scripts/generate-route-index'))
    skills = {row['skill']: row for row in routes['collect_rows']()}
    document = json.loads(SOURCE.read_text())
    if document.get('schema_version') != 1:
        raise ValueError('unsupported workflow schema')
    lines = ['# Daily workflows', '',
             'Generated by `scripts/generate-workflow-guide` from [recipes](./daily-workflows.json) and live skill metadata. Do not hand-edit.', '',
             'Start with the named entry. The remaining skills are conditional handoffs owned by the caller, not a mandatory sequence. Existing permission and workspace boundaries carry through every step.', '',
             'For ambiguous requests use `/0-butler`; clear requests can go straight to their entry.', '',
             '| Task | Start with | Finish when |', '|---|---|---|']
    seen = set()
    for flow in document['workflows']:
        if flow['id'] in seen or flow['entry'] not in flow['steps']:
            raise ValueError('duplicate recipe or missing entry in steps')
        seen.add(flow['id'])
        for name in flow['steps']:
            if name not in skills:
                raise ValueError(f'unknown live workflow skill: {name}')
        for field in ['goal', 'example', 'finish']:
            if not isinstance(flow.get(field), str) or not flow[field].strip():
                raise ValueError(f'missing workflow {field}')
        lines.append(f"| {flow['goal']} | [/{flow['entry']}](../../skills/{flow['entry']}/SKILL.md) | {flow['finish']} |")
    for flow in document['workflows']:
        lines.extend(['', f"## {flow['goal']}", '',
                      f"`/{flow['entry']} {flow['example']}`", '',
                      'Possible owners: ' + ' → '.join(f"[/{name}](../../skills/{name}/SKILL.md)" for name in flow['steps']) + '.', '',
                      f"Owning domain: `/{skills[flow['entry']]['hub']}`."])
    lines.extend(['', '## Local tooling', '',
                  'See [adopted pstack tooling](./pstack-tooling.md) for statecharts, PR status, worktree audits, decision logs, and blinded review packets.', '',
                  'For a selected behavior campaign, use the existing [evaluation harness](./ai-native-evaluation.md). Structural checks and deterministic fixture checks are distinct from provider-backed workflow evidence.', ''])
    return '\n'.join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true')
    args = parser.parse_args()
    expected = render()
    if args.check:
        if not OUTPUT.is_file() or OUTPUT.read_text() != expected:
            parser.exit(1, 'Daily workflow guide is stale. Run rtk python3 scripts/generate-workflow-guide\n')
    else:
        OUTPUT.write_text(expected)
    print('Daily workflow guide current' if args.check else 'Generated daily workflow guide')


if __name__ == '__main__':
    main()
