#!/usr/bin/env python3
"""Mirror skill-manager / skill-linter checklists for non-LLM / CI runs.

Exit 0 if no critical findings; exit 1 if any critical.
See ADR 0005 (hub packages) and ADR 0006 (skill-linter + hub membership).
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
# Catalog root is the repo (skills/, hubs/, archive/, inbox/, wikis/ live here).
CATALOG = ROOT
HUBS_DIR = CATALOG / "hubs"
FLOWS = CATALOG / "skills" / "0-butler" / "references" / "flows.md"
CATALOG_YAML = CATALOG / "catalog.yaml"


def catalog_version() -> str:
    """Read version from catalog.yaml without requiring PyYAML."""
    if not CATALOG_YAML.is_file():
        return "unknown"
    for line in CATALOG_YAML.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if line.startswith("version:"):
            return line.split(":", 1)[1].strip().strip('"').strip("'")
    return "unknown"
# Domain packages with live skills
LIVE_BUCKETS = ["skills"]  # flat live skill parent
BUCKETS = ["skills", "inbox", "archive"]
PROMOTED = {"skills"}  # root README points at skills/; promotion is "not archive/inbox"
HARD_DEP_SKILLS = {"1-to-spec", "1-to-tickets", "0-triage"}
FORBIDDEN_LIVE = {"using-agent-skills", "setup-matt-pocock-skills"}
# Live skills: {depth}-{kebab-slug} (CLAUDE.md / depth-prefix-names.md hard rule)
DEPTH_PREFIX = re.compile(r"^[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$")
# Route surface (D2): these must NOT appear as top-level frontmatter keys
ROUTE_TOP_LEVEL_FORBIDDEN = {
    "hub",
    "when",
    "not_when",
    "next",
    "prev",
    "cousins",
    "triggers",
    "role",
    "requires_setup",
}
# Allow line breaks inside the phrase (folded YAML descriptions).
# Prefer matching "Triggers:" without requiring a trailing word-boundary after ":".
DESC_TRIGGER = re.compile(
    r"(?is)(?:\buse\s+when\b|\buse\s+for\b|\buse\s+on\b|\btriggers?\s*:|\btrigger\s+on\b)"
)
CATALOG_HUB = re.compile(
    r"(?m)^[ \t]+hub:\s*[\"']?([0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*)[\"']?\s*$"
)
ROUTE_INDEX = CATALOG / "skills" / "0-butler" / "references" / "route-index.md"
ROUTE_INDEX_JSON = CATALOG / "skills" / "0-butler" / "references" / "route-index.json"
DESCRIPTION_HUB = re.compile(r"(?i)\bhub:\s*/?([0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*)\b")
# workflow.json may list ops verbs that are not skills
NON_SKILL_TOKENS = {
    "create",
    "read",
    "update",
    "delete",
    "place",
    "new-hub",
    "ingest",
    "organize",
    "lint",
    "atomize",
    "Spec",
    "Standards",
    "Maintainability",
    "commit",
}
LEAN_SOFT_LINES = 120
LEAN_WARN_LINES = 180
SPRAWL_WARN_LINES = 250
SUBDOMAIN_WARN_LINES = 400
REF_COUNT_SUBDOMAIN = 5
MD_LINK = re.compile(r"\]\(([^)]+)\)")
PROCESS_HEADING = re.compile(
    r"(?im)^#{1,3}\s+(process|dispatch|steps|workflow|session start|build path)\b"
)
SKILL_REFERENCE = re.compile(r"(?<![A-Za-z0-9-])([0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*)(?![A-Za-z0-9-])")
SLASH_SKILL_REFERENCE = re.compile(r"(?<![A-Za-z0-9-])/([0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*)")
BACKTICK_SKILL_REFERENCE = re.compile(r"`([0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*)`")


def skills_in_bucket(bucket: str) -> list[Path]:
    base = CATALOG / bucket
    if not base.is_dir():
        return []
    out = []
    for d in sorted(base.iterdir()):
        if d.is_symlink():
            continue  # dual-membership; primary counted in owning domain
        if d.is_dir() and (d / "SKILL.md").is_file():
            out.append(d)
    return out


def frontmatter(text: str) -> dict[str, str]:
    if not text.startswith("---"):
        return {}
    parts = text.split("---", 2)
    if len(parts) < 3:
        return {}
    meta = {}
    for line in parts[1].splitlines():
        if ":" in line and not line.startswith(" "):
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip().strip('"').strip("'")
    return meta


def frontmatter_text(text: str) -> str:
    if not text.startswith("---"):
        return ""
    parts = text.split("---", 2)
    return parts[1] if len(parts) == 3 else ""


def catalog_role(text: str) -> str | None:
    """Read metadata.catalog.role from the intentionally constrained house schema."""
    match = re.search(
        r"(?m)^  catalog:\s*$[\s\S]*?^    role:\s*[\"']?([a-z0-9-]+)[\"']?\s*$",
        frontmatter_text(text),
    )
    return match.group(1) if match else None


def parse_claude_invocation_policy(text: str) -> tuple[bool, str | None]:
    """Return effective Claude implicit invocation and any malformed-value error."""
    matches = re.findall(
        r"(?m)^disable-model-invocation:\s*([^#\n]+?)\s*(?:#.*)?$",
        frontmatter_text(text),
    )
    if len(matches) > 1:
        return True, "duplicate disable-model-invocation keys"
    if not matches:
        return True, None
    value = matches[0].strip().casefold()
    if value == "true":
        return False, None
    if value == "false":
        return True, None
    return True, f"disable-model-invocation must be true or false, got {matches[0].strip()!r}"


def parse_codex_invocation_policy(text: str) -> tuple[bool | None, str | None]:
    """Read policy.allow_implicit_invocation without depending on a YAML package."""
    lines = text.splitlines()
    policy_indexes = [
        index for index, line in enumerate(lines)
        if re.fullmatch(r"policy:\s*(?:#.*)?", line)
    ]
    if len(policy_indexes) > 1:
        return None, "duplicate top-level policy sections"
    all_keys = [
        index for index, line in enumerate(lines)
        if re.match(r"^\s*allow_implicit_invocation\s*:", line)
    ]
    if not policy_indexes:
        if all_keys:
            return None, "allow_implicit_invocation must be nested under top-level policy"
        return None, None

    start = policy_indexes[0] + 1
    end = len(lines)
    for index in range(start, len(lines)):
        line = lines[index]
        if line and not line[0].isspace() and not line.lstrip().startswith("#"):
            end = index
            break
    matches = []
    for line in lines[start:end]:
        match = re.fullmatch(
            r"\s+allow_implicit_invocation:\s*([^#\s]+)\s*(?:#.*)?",
            line,
        )
        if match:
            matches.append(match.group(1))
    if len(matches) > 1:
        return None, "duplicate policy.allow_implicit_invocation keys"
    if not matches:
        return None, None
    value = matches[0].casefold()
    if value == "true":
        return True, None
    if value == "false":
        return False, None
    return None, f"policy.allow_implicit_invocation must be true or false, got {matches[0]!r}"


def analyze_invocation_policies(
    skill_dirs: list[Path], *, context_budget_limit: int = 25
) -> tuple[dict[str, dict], list[tuple[str, str, str]]]:
    """Classify Claude and Codex independently and enforce catalog conventions."""
    runtime = {
        "claude": {"implicitly_invocable": [], "manual_only": [], "policy_violations": []},
        "codex": {"implicitly_invocable": [], "manual_only": [], "policy_violations": []},
    }
    findings: list[tuple[str, str, str]] = []
    for skill_dir in sorted(skill_dirs, key=lambda path: path.name):
        name = skill_dir.name
        skill_text = (skill_dir / "SKILL.md").read_text(encoding="utf-8", errors="replace")

        claude_implicit, claude_error = parse_claude_invocation_policy(skill_text)
        runtime["claude"]["implicitly_invocable" if claude_implicit else "manual_only"].append(name)
        claude_expected = name == "1-coding-standards"
        if claude_error:
            message = f"skills/{name}/SKILL.md: malformed Claude invocation policy: {claude_error}"
            runtime["claude"]["policy_violations"].append(message)
            findings.append(("critical", "claude-invocation-policy", message))
        if claude_implicit != claude_expected:
            expected = "implicit" if claude_expected else "manual-only"
            message = f"skills/{name}/SKILL.md: Claude must be {expected}"
            runtime["claude"]["policy_violations"].append(message)
            findings.append(("critical", "claude-invocation-policy", message))

        manifest = skill_dir / "agents" / "openai.yaml"
        manifest_text = manifest.read_text(encoding="utf-8", errors="replace") if manifest.is_file() else ""
        codex_setting, codex_error = parse_codex_invocation_policy(manifest_text)
        # Codex defaults to implicit when no valid explicit false setting is present.
        codex_implicit = codex_setting is not False
        runtime["codex"]["implicitly_invocable" if codex_implicit else "manual_only"].append(name)
        codex_expected = catalog_role(skill_text) == "hub" or name == "1-coding-standards"
        if codex_error:
            message = f"skills/{name}/agents/openai.yaml: malformed Codex invocation policy: {codex_error}"
            runtime["codex"]["policy_violations"].append(message)
            findings.append(("critical", "codex-manifest-policy", message))
        if codex_expected and not codex_implicit:
            message = f"skills/{name}/agents/openai.yaml: Codex hub/coding-standard skill must be implicit"
            runtime["codex"]["policy_violations"].append(message)
            findings.append(("critical", "codex-invocation-policy", message))
        elif not codex_expected and codex_setting is not False:
            detail = "must explicitly set policy.allow_implicit_invocation: false"
            message = f"skills/{name}/agents/openai.yaml: Codex manual-only skill {detail}"
            runtime["codex"]["policy_violations"].append(message)
            findings.append(("critical", "codex-invocation-policy", message))

    for runtime_name, report in runtime.items():
        implicit_count = len(report["implicitly_invocable"])
        report["implicit_count"] = implicit_count
        report["manual_only_count"] = len(report["manual_only"])
        warning = None
        if implicit_count > context_budget_limit:
            warning = (
                f"{runtime_name} implicitly invocable count {implicit_count} exceeds "
                f"the context-budget target of {context_budget_limit}"
            )
            findings.append(("warn", f"{runtime_name}-invocation-budget", warning))
        report["context_budget_warning"] = warning
    return runtime, findings


def collect_hub_members() -> set[str]:
    members: set[str] = set()
    if HUBS_DIR.is_dir():
        for wf in HUBS_DIR.glob("*/workflow.json"):
            try:
                data = json.loads(wf.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                continue
            hub = data.get("hub")
            if isinstance(hub, str) and hub:
                members.add(hub)
            for child in data.get("children") or []:
                skills = child.get("skills") or []
                for s in skills:
                    if isinstance(s, str) and s and s not in NON_SKILL_TOKENS:
                        members.add(s)
    if FLOWS.is_file():
        text = FLOWS.read_text(encoding="utf-8", errors="replace")
        for m in re.finditer(r"`([0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*)`", text):
            name = m.group(1)
            if name not in NON_SKILL_TOKENS:
                members.add(name)
        for m in re.finditer(r"\*\*★ Hub\*\*\s*\|\s*`/([^`]+)`", text):
            members.add(m.group(1).strip())
    return members


def check_relative_links(skill_dir: Path, text: str, findings: list, rel: str) -> None:
    skip_exact = {"link", "url", "path", "href", "...", "file"}
    for m in MD_LINK.finditer(text):
        target = m.group(1).strip()
        if target.startswith(("http://", "https://", "mailto:", "file:", "#")):
            continue
        # strip anchors
        path_part = target.split("#", 1)[0].split("?", 1)[0]
        if not path_part or path_part.startswith("/"):
            continue
        # example / placeholder links in skill docs
        if path_part.lower() in skip_exact or "path/to" in path_part or path_part.startswith("<"):
            continue
        # only treat as filesystem paths when they look like relative files
        if not (
            path_part.startswith("./")
            or path_part.startswith("../")
            or path_part.startswith("references/")
            or path_part.startswith("scripts/")
            or path_part.endswith((".md", ".json", ".sh", ".py", ".txt", ".yaml", ".yml"))
        ):
            continue
        resolved = (skill_dir / path_part).resolve()
        try:
            resolved.relative_to(ROOT.resolve())
        except ValueError:
            continue
        if not resolved.exists():
            findings.append(("critical", "ref-exists", f"{rel}: broken link → {target}"))


def check_handoff_targets(
    text: str, live_names: set[str], findings: list, rel: str, pattern: re.Pattern[str]
) -> None:
    """Require skill identifiers in a routing surface to name a live skill."""
    for target in sorted(set(pattern.findall(text))):
        if target not in live_names:
            findings.append(("critical", "handoff-target", f"{rel}: unknown skill handoff → {target}"))


def reachable_package_files(skill_dir: Path) -> set[Path]:
    """Follow local documentation links, preserving paths and stopping at package edges.

    Markdown links and explicit backticked file pointers are navigation evidence;
    merely mentioning a basename is not. Read Markdown only; never execute assets,
    fetch URLs or walk a linked sibling/vendor package. Cycles are visited once.
    """
    root = skill_dir.resolve()
    pending = [root / "SKILL.md"]
    reached: set[Path] = set()
    while pending:
        source = pending.pop()
        if source in reached or not source.is_file():
            continue
        reached.add(source)
        if source.suffix.lower() != ".md":
            continue
        try:
            content = source.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        targets = MD_LINK.findall(content)
        targets += re.findall(r"`([^`\n]+\.(?:md|json|txt|yaml|yml|py|js|sh))`", content)
        for target in targets:
            target = target.strip()
            if not target or target.startswith(("/", "http:", "https:", "mailto:", "file:")):
                continue
            # Angle-bracket paths may contain spaces; optional titles are not paths.
            if target.startswith("<") and ">" in target:
                target = target[1:target.index(">")]
            elif ' "' in target:
                target = target.split(' "', 1)[0]
            target = target.split("#", 1)[0].split("?", 1)[0]
            try:
                candidate = (source.parent / target).resolve()
                candidate.relative_to(root)
            except (ValueError, OSError, RuntimeError):
                continue
            if candidate.is_file() and candidate not in reached:
                pending.append(candidate)
    return reached


def catalog_route_block(text: str) -> str:
    """Return metadata.catalog only, avoiding arbitrary examples in the skill body."""
    if not text.startswith("---"):
        return ""
    parts = text.split("---", 2)
    if len(parts) < 3:
        return ""
    match = re.search(r"(?m)^  catalog:\s*$([\s\S]*?)(?=^  [a-z_][a-z_]*:|\Z)", parts[1])
    return match.group(0) if match else ""


def check_declared_parent(name: str, hub: str, parents: list, findings: list, rel: str) -> None:
    """Membership elsewhere does not establish membership under the declared parent."""
    if name != hub and hub not in {parent[0] for parent in parents}:
        findings.append(("warn", "route-hub", f"{rel}: declared parent {hub!r} has no child membership for this skill; reconcile workflow/flows ownership"))


def report_document(
    findings: list[tuple[str, str, str]],
    *,
    invocation_policies: dict[str, dict],
    hub_members: set[str],
    orphans: list[str],
) -> dict:
    counts = {
        severity: sum(1 for finding in findings if finding[0] == severity)
        for severity in ("critical", "warn", "info")
    }
    return {
        "schema_version": 2,
        "catalog_root": str(CATALOG),
        "catalog_version": catalog_version(),
        "summary": counts,
        "invocation_policies": invocation_policies,
        "hub_members_indexed": len(hub_members),
        "hub_member_orphans": orphans,
        "gate": "FAIL" if counts["critical"] else "PASS",
        "findings": [
            {"severity": severity, "code": code, "message": message}
            for severity, code, message in findings
        ],
    }


def print_markdown_report(report: dict) -> None:
    summary = report["summary"]
    print("# Catalog lint")
    print(f"**Catalog root:** {report['catalog_root']}")
    print(f"**Catalog version:** {report['catalog_version']} (`catalog.yaml`)")
    print(
        f"**Summary:** {summary['critical']} critical, {summary['warn']} warn, {summary['info']} info"
    )
    print(f"**Hub members indexed:** {report['hub_members_indexed']}")
    print(f"**Hub-member orphans:** {len(report['hub_member_orphans'])}")
    if report["hub_member_orphans"]:
        orphans = report["hub_member_orphans"]
        print(f"**Orphan sample:** {', '.join(orphans[:20])}{'…' if len(orphans) > 20 else ''}")
    print(f"**Gate:** {report['gate']}")
    for runtime_name in ("claude", "codex"):
        policy = report["invocation_policies"][runtime_name]
        print(f"\n## {runtime_name.title()} invocation policy")
        implicit = policy["implicitly_invocable"]
        manual = policy["manual_only"]
        print(f"**Implicitly invocable ({len(implicit)}):** {', '.join(implicit) or '(none)'}")
        print(f"**Manual-only ({len(manual)}):** {', '.join(manual) or '(none)'}")
        violations = policy["policy_violations"]
        print(f"**Policy violations ({len(violations)}):**")
        if violations:
            for violation in violations:
                print(f"- {violation}")
        else:
            print("- (none)")
        warning = policy["context_budget_warning"]
        print(f"**Context-budget warning:** {warning or '(none)'}")
    for severity in ("critical", "warn", "info"):
        print(f"\n## {severity}")
        matches = [
            finding for finding in report["findings"] if finding["severity"] == severity
        ]
        if matches:
            for finding in matches:
                print(f"- [{finding['code']}] {finding['message']}")
        else:
            print("- (none)")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--format", choices=("markdown", "json"), default="markdown",
        help="report format (default: markdown)",
    )
    args = parser.parse_args(argv)
    findings: list[tuple[str, str, str]] = []

    nested = []
    cfg = ROOT / "scripts" / "symlink-targets.json"
    if cfg.exists():
        nested = json.loads(cfg.read_text()).get("nestedSkillRoots") or []
    if any("agent-skills" in n for n in nested):
        findings.append(
            ("critical", "vendor", "nestedSkillRoots still includes agent-skills — dual-router risk")
        )

    using = list(CATALOG.rglob("using-agent-skills/SKILL.md"))
    for u in using:
        if "vendor" in u.parts:
            findings.append(
                ("info", "forbidden", f"using-agent-skills present under vendor only: {u.relative_to(ROOT)}")
            )
        else:
            findings.append(
                ("critical", "forbidden", f"using-agent-skills discoverable outside vendor: {u}")
            )

    if any((CATALOG / b / "setup-matt-pocock-skills").exists() for b in LIVE_BUCKETS):
        findings.append(("critical", "forbidden", "setup-matt-pocock-skills still present"))
    if not (CATALOG / "skills" / "0-setup-rohitas-skills" / "SKILL.md").exists():
        findings.append(("critical", "forbidden", "0-setup-rohitas-skills missing"))

    if any((CATALOG / b / "ask-matt").exists() for b in LIVE_BUCKETS):
        findings.append(
            ("critical", "forbidden", "ask-matt still under a live domain (should be archive)")
        )
    if not (CATALOG / "archive" / "ask-matt" / "SKILL.md").exists():
        findings.append(("warn", "tombstone", "ask-matt tombstone missing under archive/"))

    if not (CATALOG / "skills" / "0-butler" / "SKILL.md").exists():
        findings.append(("critical", "forbidden", "0-butler skill missing"))
    if not (CATALOG / "skills" / "1-skill-linter" / "SKILL.md").exists():
        findings.append(("critical", "forbidden", "1-skill-linter missing (ADR 0006)"))

    tdd_hits = [
        p
        for p in CATALOG.rglob("**/1-tdd/SKILL.md")
        if not any(x in p.parts for x in ("vendor", "archive", "hubs", "guidelines", "wikis"))
    ]
    tdd_hits += [
        p for p in CATALOG.rglob("**/test-driven-development/SKILL.md") if "vendor" not in p.parts
    ]
    if len([p for p in tdd_hits if p.parent.name == "1-tdd"]) != 1:
        findings.append(("warn", "tdd", f"unexpected tdd paths: {tdd_hits}"))
    if any(p.parent.name == "test-driven-development" and "vendor" not in p.parts for p in tdd_hits):
        findings.append(("critical", "tdd", "second TDD skill outside vendor"))

    # Hub package integrity (ADR 0005)
    if HUBS_DIR.is_dir():
        for wf in sorted(HUBS_DIR.glob("*/workflow.json")):
            hub_dir = wf.parent
            if not DEPTH_PREFIX.match(hub_dir.name):
                findings.append(
                    (
                        "critical",
                        "depth-hub",
                        f"hub package dir {hub_dir.name!r} must be depth-prefixed (0- domain hubs; sub-hubs parent+1 → 1-/2-/3-/…)",
                    )
                )
            try:
                data = json.loads(wf.read_text(encoding="utf-8"))
                hub = data.get("hub") or ""
                if hub and hub != hub_dir.name:
                    findings.append(
                        ("critical", "depth-hub", f"{hub_dir.name}: workflow hub={hub!r} != dir")
                    )
                if hub and not DEPTH_PREFIX.match(str(hub)):
                    findings.append(
                        ("critical", "depth-hub", f"{hub_dir.name}: workflow hub={hub!r} missing depth prefix")
                    )
            except json.JSONDecodeError:
                findings.append(("critical", "hub-workflow-json", f"invalid JSON: {wf}"))
            if not (hub_dir / "hub.html").is_file():
                findings.append(("critical", "hub-html", f"missing hub.html for {hub_dir.name}"))
        if not (HUBS_DIR / "manifest.json").is_file():
            findings.append(("warn", "hub-workflow-json", "hubs/manifest.json missing"))
    else:
        findings.append(("warn", "hub-dir", f"hub packages dir missing: {HUBS_DIR}"))

    # Depth-graph: name prefix = full hub-tree depth (max parent_depth+1; hub identity special-cased)
    def expected_tree_depth(
        live: set[str],
    ) -> tuple[dict[str, int], dict[str, str], dict[str, list]]:
        """Return expected depth, deepest parent label, and all parents per skill."""
        wfs: dict[str, dict] = {}
        if HUBS_DIR.is_dir():
            for wf in HUBS_DIR.glob("*/workflow.json"):
                try:
                    data = json.loads(wf.read_text(encoding="utf-8"))
                except json.JSONDecodeError:
                    continue
                hub = data.get("hub")
                if isinstance(hub, str) and hub:
                    wfs[hub] = data
        # Hub package depths (domain 0; nested sub-hub = parent+1)
        hdepth: dict[str, int] = {}
        for h, d in wfs.items():
            if not d.get("parent_domain_hub"):
                hdepth[h] = 0
        changed = True
        while changed:
            changed = False
            for h, d in wfs.items():
                pd = d.get("parent_domain_hub")
                if not pd:
                    continue
                parent = pd if pd in wfs else None
                if parent is None:
                    for cand in wfs:
                        bare = cand.split("-", 1)[-1] if "-" in cand else cand
                        if cand == pd or bare == pd or cand.endswith("-" + str(pd)):
                            parent = cand
                            break
                if parent is None:
                    nd = 1
                elif parent not in hdepth:
                    continue
                else:
                    nd = hdepth[parent] + 1
                if hdepth.get(h) != nd:
                    hdepth[h] = nd
                    changed = True
        parents: dict[str, list] = {s: [] for s in live}
        for hub, data in wfs.items():
            for group in data.get("children") or []:
                lt = group.get("link_type") or "soft"
                if lt in ("tombstone", "ops", "ssot"):
                    continue
                for s in group.get("skills") or []:
                    if not isinstance(s, str) or s in NON_SKILL_TOKENS or s == hub:
                        continue
                    if s not in live:
                        continue
                    parents[s].append((hub, hdepth.get(hub, 0), lt))
        expected: dict[str, int] = {}
        deepest_of: dict[str, str] = {}
        for s in live:
            if s in hdepth and s in wfs:
                expected[s] = hdepth[s]
                deepest_of[s] = f"hub-identity:{s}"
                continue
            ps = parents.get(s) or []
            if not ps:
                continue
            best = max(ps, key=lambda p: p[1])
            expected[s] = best[1] + 1
            deepest_of[s] = f"{best[0]}(d={best[1]},{best[2]})"
        return expected, deepest_of, parents

    live_names = {d.name for d in skills_in_bucket("skills")}
    if FLOWS.is_file():
        check_handoff_targets(
            FLOWS.read_text(encoding="utf-8", errors="replace"),
            live_names,
            findings,
            "skills/0-butler/references/flows.md",
            BACKTICK_SKILL_REFERENCE,
        )
    if HUBS_DIR.is_dir():
        for workflow in HUBS_DIR.glob("*/workflow.json"):
            check_handoff_targets(
                workflow.read_text(encoding="utf-8", errors="replace"),
                live_names,
                findings,
                str(workflow.relative_to(CATALOG)),
                SKILL_REFERENCE,
            )
    exp_depth, deepest_of, all_parents = expected_tree_depth(live_names)
    for name in sorted(live_names):
        m = re.match(r"^(\d+)-", name)
        if not m:
            continue  # depth-prefix check already flags
        actual = int(m.group(1))
        exp = exp_depth.get(name)
        if exp is None:
            findings.append(
                (
                    "critical",
                    "depth-graph",
                    f"skills/{name}: no hub parents and not a domain/sub-hub — cannot assign tree depth",
                )
            )
            continue
        if actual != exp:
            findings.append(
                (
                    "critical",
                    "depth-graph",
                    f"skills/{name}: name depth={actual} but hub-tree depth={exp} via {deepest_of.get(name)}",
                )
            )
        if len(all_parents.get(name) or []) >= 2:
            findings.append(
                (
                    "info",
                    "depth-dual",
                    f"skills/{name}: dual membership; deepest={deepest_of.get(name)}; parents={[p[0] for p in all_parents[name]]}",
                )
            )

    hub_members = collect_hub_members()
    # Atomic root README: skill listing SSOT is wikis/index.md (not root README)
    wiki_index = (
        (CATALOG / "wikis" / "index.md").read_text(encoding="utf-8")
        if (CATALOG / "wikis" / "index.md").exists()
        else ""
    )
    orphans: list[str] = []

    for bucket in BUCKETS:
        readme = CATALOG / bucket / "README.md"
        readme_text = readme.read_text(encoding="utf-8") if readme.exists() else ""
        for d in skills_in_bucket(bucket):
            rel = f"{bucket}/{d.name}"
            text = (d / "SKILL.md").read_text(encoding="utf-8", errors="replace")
            lines = text.count("\n") + 1
            meta = frontmatter(text)
            name = meta.get("name", "")
            if name and name != d.name:
                findings.append(("critical", "name-dir", f"{rel}: name={name!r} != dir"))
            # Depth-prefix hard rule: promoted live skills only.
            # inbox/ is exempt until place (rename + prefix happens at promote).
            if bucket in PROMOTED:
                if not DEPTH_PREFIX.match(d.name):
                    findings.append(
                        (
                            "critical",
                            "depth-prefix",
                            f"{rel}: dir must be {{depth}}-{{kebab-slug}} (e.g. 0-butler, 1-to-tickets)",
                        )
                    )
                if name and not DEPTH_PREFIX.match(name):
                    findings.append(
                        (
                            "critical",
                            "depth-prefix",
                            f"{rel}: frontmatter name={name!r} missing depth prefix",
                        )
                    )
            fm = text.split("---", 2)[1] if text.startswith("---") else ""
            if "description:" not in fm:
                findings.append(("critical", "frontmatter", f"{rel}: missing description"))

            # Flat skills/: index lives in wikis/, not a per-skill bucket README listing
            if bucket == "skills":
                if d.name not in wiki_index and f"[[{d.name}]]" not in wiki_index:
                    findings.append(
                        ("warn", "wiki-index", f"{rel} not listed in wikis/index.md")
                    )
            elif bucket != "archive":
                if f"[{d.name}]" not in readme_text and d.name not in readme_text:
                    findings.append(("warn", "bucket-readme", f"{rel} not listed in bucket README"))

            if d.name in HARD_DEP_SKILLS and "0-setup-rohitas-skills" not in text and "setup-rohitas-skills" not in text:
                findings.append(
                    ("critical", "hard-dep", f"{d.name} missing /0-setup-rohitas-skills pointer")
                )

            # Route surface: no top-level route keys (D2); description-triggers / catalog hub (live)
            if bucket in PROMOTED:
                for key in ROUTE_TOP_LEVEL_FORBIDDEN:
                    if key in meta:
                        findings.append(
                            (
                                "critical",
                                "route-top-level",
                                f"{rel}: top-level {key!r} forbidden — use metadata.catalog only "
                                f"(see 0-skill-manager/references/skill-route-surface.md)",
                            )
                        )
                # description when-to-use signal (all live, not only model-invoked)
                desc_blob = fm
                if not DESC_TRIGGER.search(desc_blob) and not DESC_TRIGGER.search(text[:800]):
                    # only flag when description exists and is short/weak on triggers
                    if "description:" in fm:
                        findings.append(
                            (
                                "warn",
                                "description-triggers",
                                f"{rel}: description lacks Use when / Triggers signal (butler route surface)",
                            )
                        )
                mhub = CATALOG_HUB.search(fm)
                if mhub:
                    chub = mhub.group(1)
                    description_hub = DESCRIPTION_HUB.search(fm)
                    if description_hub and description_hub.group(1) != chub:
                        findings.append(
                            (
                                "warn",
                                "route-description-hub",
                                f"{rel}: description Hub {description_hub.group(1)!r} disagrees with metadata.catalog.hub {chub!r}",
                            )
                        )
                    check_declared_parent(d.name, chub, all_parents.get(d.name, []), findings, rel)
                    # hub field must match a known hub package or member set includes skill under hub
                    hub_dirs = {p.name for p in HUBS_DIR.glob("*") if p.is_dir()} if HUBS_DIR.is_dir() else set()
                    if chub not in hub_dirs and chub not in hub_members:
                        findings.append(
                            (
                                "warn",
                                "route-hub",
                                f"{rel}: metadata.catalog.hub={chub!r} not a known hub package",
                            )
                        )

            if d.name in FORBIDDEN_LIVE and bucket in PROMOTED:
                findings.append(
                    ("critical", "forbidden", f"forbidden live skill in promoted bucket: {d.name}")
                )

            if "/Users/" in text and ("vault" in d.name.lower() or bucket == "personal"):
                findings.append(("warn", "vault-ssot", f"{rel} still contains /Users/ absolute path"))

            # Relative links from SKILL.md
            check_relative_links(d, text, findings, rel)
            if bucket in PROMOTED:
                check_handoff_targets(text, live_names, findings, rel, SLASH_SKILL_REFERENCE)
                check_handoff_targets(
                    catalog_route_block(text), live_names, findings, rel, SKILL_REFERENCE
                )

            # references orphans
            ref_dir = d / "references"
            if ref_dir.is_dir():
                linked = reachable_package_files(d)
                ref_files = [p for p in ref_dir.rglob("*") if p.is_file() and p.suffix in {".md", ".json", ".txt"}]
                for rf in ref_files:
                    if rf.resolve() not in linked:
                        findings.append(
                            ("warn", "ref-orphan", f"{rel}: references/{rf.relative_to(ref_dir)} not reachable from SKILL.md through local documentation links")
                        )
                if len(ref_files) > REF_COUNT_SUBDOMAIN and lines > SPRAWL_WARN_LINES:
                    findings.append(
                        (
                            "warn",
                            "subdomain-candidate",
                            f"{rel}: {lines} lines, {len(ref_files)} ref files — consider split or sub-domain hub",
                        )
                    )

            # Lean + sprawl (main SKILL.md must stay thin)
            has_refs_map = "references/" in text and (
                "progressive" in text.lower()
                or "load" in text.lower()
                or "| " in text
                or "](./references" in text
                or "](references/" in text
            )
            has_sibling_pointer = bool(
                re.search(r"\]\((?:\./)?[A-Za-z0-9_./-]+\.md\)", text)
            )
            disclosed = has_refs_map or (has_sibling_pointer and lines <= SPRAWL_WARN_LINES)
            if lines > SUBDOMAIN_WARN_LINES:
                findings.append(
                    (
                        "warn",
                        "subdomain-candidate",
                        f"{rel}: SKILL.md has {lines} lines — thin (lean) then split or sub-domain hub",
                    )
                )
            elif lines > SPRAWL_WARN_LINES and not has_refs_map:
                findings.append(
                    (
                        "warn",
                        "sprawl",
                        f"{rel}: SKILL.md has {lines} lines without progressive disclosure — keep main file lean",
                    )
                )
            elif lines > LEAN_WARN_LINES and not disclosed:
                findings.append(
                    (
                        "warn",
                        "lean",
                        f"{rel}: SKILL.md has {lines} lines (lean target ≤{LEAN_SOFT_LINES}; disclose refs if >{LEAN_WARN_LINES})",
                    )
                )
            elif lines > LEAN_SOFT_LINES:
                findings.append(
                    (
                        "info",
                        "lean-soft",
                        f"{rel}: SKILL.md has {lines} lines (soft lean target ≤{LEAN_SOFT_LINES})",
                    )
                )

            # Lean shape: process/dispatch/steps, tiny router, or intentional all-reference
            if lines > 100 and not PROCESS_HEADING.search(text):
                intentional_ref = bool(
                    re.search(
                        r"(?i)all reference|reference for |## (invocation|information hierarchy|pruning|failure modes)\b",
                        text,
                    )
                ) or (d / "GLOSSARY.md").is_file()
                if not intentional_ref:
                    findings.append(
                        (
                            "warn",
                            "lean-shape",
                            f"{rel}: no Process/Dispatch/Steps heading — lean skills use ordered steps, tiny routers, or disclosed all-reference",
                        )
                    )

            # chain blurb heuristics
            chainish = bool(
                re.search(
                    r"(?i)(/tdd|/code-review|/implement|/to-spec|build path|related|next:|prev:|→)",
                    text,
                )
            )
            if bucket in LIVE_BUCKETS and d.name in hub_members and not chainish and lines > 30:
                # leaf tools (misc) often skip chain prose
                if True:  # flat skills: still emit chain-next info
                    findings.append(
                        (
                            "info",
                            "chain-next",
                            f"{rel}: no obvious chain/next blurb — pipeline skills should name next skill(s)",
                        )
                    )

            # hub membership (live only; personal residual = warn)
            if bucket in LIVE_BUCKETS:
                if d.name not in hub_members:
                    orphans.append(rel)
                    sev = "critical"
                    findings.append(
                        (
                            sev,
                            "hub-member",
                            f"{rel}: not listed under any domain hub workflow (flows.md / hubs/*/workflow.json)",
                        )
                    )

    invocation_policies, invocation_findings = analyze_invocation_policies(
        skills_in_bucket("skills")
    )
    findings.extend(invocation_findings)

    lock_path = CATALOG / "skills-lock.json"
    if lock_path.exists():
        lock = json.loads(lock_path.read_text())
        for sk, meta in lock.get("skills", {}).items():
            sp = meta.get("skillPath", "")
            candidates = [ROOT / sp, CATALOG / sp, CATALOG / sp.removeprefix("skills/")]
            if not any(c.is_file() for c in candidates):
                findings.append(("critical", "lock", f"lock path missing for {sk}: {sp}"))

    dep_readme = CATALOG / "archive" / "README.md"
    if dep_readme.exists():
        dep_text = dep_readme.read_text()
        for d in skills_in_bucket("archive"):
            if d.name not in dep_text:
                findings.append(("warn", "tombstone", f"archive/{d.name} not in deprecated README"))

    if not CATALOG_YAML.is_file():
        findings.append(
            (
                "warn",
                "catalog-meta",
                "missing catalog.yaml — version SSOT for conventions (docs/FEATURE-LOG.md)",
            )
        )

    # Route projection presence, parseability, coverage, and timestamp freshness.
    if not ROUTE_INDEX.is_file():
        findings.append(
            (
                "info",
                "route-index-stale",
                "missing skills/0-butler/references/route-index.md — run scripts/generate-route-index",
            )
        )
    if not ROUTE_INDEX_JSON.is_file():
        findings.append(
            (
                "info",
                "route-index-stale",
                "missing skills/0-butler/references/route-index.json — run scripts/generate-route-index",
            )
        )
    else:
        try:
            route_manifest = json.loads(ROUTE_INDEX_JSON.read_text(encoding="utf-8"))
            if not isinstance(route_manifest, dict):
                raise ValueError("top level must be an object")
            manifest_skills = route_manifest.get("skills")
            if not isinstance(manifest_skills, list):
                raise ValueError("skills must be a list")
            manifest_names = {
                item.get("skill")
                for item in manifest_skills
                if isinstance(item, dict)
            }
            if route_manifest.get("schema_version") != 1:
                findings.append(("warn", "route-index-json", "route-index.json has unsupported schema_version"))
            if route_manifest.get("skill_count") != len(manifest_skills):
                findings.append(("warn", "route-index-json", "route-index.json skill_count does not match skills"))
            if manifest_names != live_names:
                missing = sorted(live_names - manifest_names)
                extra = sorted(manifest_names - live_names)
                findings.append(
                    (
                        "warn",
                        "route-index-json",
                        f"route-index.json live-skill mismatch; missing={missing[:8]}, extra={extra[:8]}",
                    )
                )
        except (json.JSONDecodeError, OSError, AttributeError, TypeError, ValueError) as exc:
            findings.append(("warn", "route-index-json", f"cannot parse route-index.json: {exc}"))

    projection_times = [
        path.stat().st_mtime for path in (ROUTE_INDEX, ROUTE_INDEX_JSON) if path.is_file()
    ]
    if projection_times:
        idx_mtime = min(projection_times)
        newest = idx_mtime
        for d in skills_in_bucket("skills"):
            try:
                newest = max(newest, (d / "SKILL.md").stat().st_mtime)
            except OSError:
                pass
        if HUBS_DIR.is_dir():
            for wf in HUBS_DIR.glob("*/workflow.json"):
                try:
                    newest = max(newest, wf.stat().st_mtime)
                except OSError:
                    pass
        if newest > idx_mtime + 1:
            findings.append(
                (
                    "info",
                    "route-index-stale",
                    "route-index.md older than some SKILL.md / workflow.json — re-run scripts/generate-route-index",
                )
            )

    report = report_document(
        findings,
        invocation_policies=invocation_policies,
        hub_members=hub_members,
        orphans=orphans,
    )
    if args.format == "json":
        print(json.dumps(report, indent=2, ensure_ascii=False, sort_keys=True))
    else:
        print_markdown_report(report)

    return 1 if report["summary"]["critical"] else 0


if __name__ == "__main__":
    sys.exit(main())
