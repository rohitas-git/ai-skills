#!/usr/bin/env python3
"""Validate, run, and summarize bounded Codex/Claude skill evaluations."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from collections import defaultdict
from pathlib import Path
from typing import Any

try:
    import resource
except ImportError:  # pragma: no cover - unavailable on Windows
    resource = None


ROOT = Path(__file__).resolve().parents[1]
SUPPORTED_RUNTIMES = {"codex", "claude"}
SUPPORTED_SKILL_SETS = {"installed", "full-live", "hub-spine"}
SUPPORTED_ASSERTIONS = {"contains", "not_contains", "file_contains", "file_equals"}
COMPARISON_PROVENANCE_FIELDS = (
    "runtime",
    "git_revision",
    "git_dirty_fingerprint",
    "catalog_version",
    "catalog_content_hash",
    "evaluation_case_hash",
    "codex_version",
    "model",
    "reasoning_effort",
    "service_tier",
)
SAFE_LABEL = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
USE_SELECTION = re.compile(
    r"(?im)^\s*\*{0,2}use:\*{0,2}\s*[`*]*?/?([0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*)"
)


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def stable_name_hash(names: set[str]) -> str:
    return sha256_bytes("".join(f"{name}\n" for name in sorted(names)).encode())


def live_skill_names(root: Path = ROOT) -> set[str]:
    return {
        path.parent.name
        for path in (root / "skills").glob("*/SKILL.md")
        if path.is_file()
    }


def derive_skill_set(
    skill_set: str,
    *,
    root: Path = ROOT,
    installed_root: Path | None = None,
) -> set[str]:
    if skill_set not in SUPPORTED_SKILL_SETS:
        raise ValueError(f"unsupported skill set: {skill_set}")
    live = live_skill_names(root)
    if skill_set == "full-live":
        return live
    if skill_set == "hub-spine":
        hubs = {
            path.parent.name
            for path in (root / "hubs").glob("*/workflow.json")
            if path.is_file()
        }
        candidate = hubs | {"1-coding-standards", "2-verify-work"}
        missing = candidate - live
        if missing:
            raise ValueError(f"hub-spine references missing live skills: {sorted(missing)}")
        return candidate
    installed = installed_root or (Path.home() / ".codex" / "skills")
    return {
        name for name in live
        if (installed / name / "SKILL.md").is_file()
    }


def catalog_content_hash(root: Path = ROOT) -> str:
    digest = hashlib.sha256()
    roots = [root / "catalog.yaml", root / "skills", root / "hubs"]
    files: list[Path] = []
    for candidate in roots:
        if candidate.is_file():
            files.append(candidate)
        elif candidate.is_dir():
            files.extend(path for path in candidate.rglob("*") if path.is_file())
    for path in sorted(files, key=lambda value: str(value.relative_to(root))):
        relative = str(path.relative_to(root)).encode()
        digest.update(len(relative).to_bytes(8, "big"))
        digest.update(relative)
        content = path.read_bytes()
        digest.update(len(content).to_bytes(8, "big"))
        digest.update(content)
    return digest.hexdigest()


def catalog_version(root: Path = ROOT) -> str:
    path = root / "catalog.yaml"
    if not path.is_file():
        return "unknown"
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if line.strip().startswith("version:"):
            return line.split(":", 1)[1].strip().strip('"').strip("'")
    return "unknown"


def git_revision(root: Path = ROOT) -> str:
    completed = subprocess.run(
        ["git", "rev-parse", "HEAD"], cwd=root, text=True, capture_output=True, check=False
    )
    return completed.stdout.strip() if completed.returncode == 0 else "unknown"


def git_dirty_fingerprint(root: Path = ROOT) -> str:
    """Hash tracked diffs plus untracked contents without changing the index or worktree."""
    digest = hashlib.sha256()
    diff = subprocess.run(
        ["git", "diff", "--binary", "HEAD", "--", "."],
        cwd=root,
        capture_output=True,
        check=False,
    )
    digest.update(diff.stdout)
    untracked = subprocess.run(
        ["git", "ls-files", "--others", "--exclude-standard", "-z"],
        cwd=root,
        capture_output=True,
        check=False,
    )
    for raw_path in sorted(value for value in untracked.stdout.split(b"\0") if value):
        digest.update(len(raw_path).to_bytes(8, "big"))
        digest.update(raw_path)
        path = root / raw_path.decode(errors="surrogateescape")
        if path.is_file():
            content = path.read_bytes()
            digest.update(len(content).to_bytes(8, "big"))
            digest.update(content)
    return digest.hexdigest()


def detect_codex_version() -> str:
    completed = subprocess.run(
        ["codex", "--version"], text=True, capture_output=True, check=False
    )
    return completed.stdout.strip() or completed.stderr.strip() or "unknown"


def build_provenance(
    *,
    cases_path: Path,
    skill_set: str,
    enabled_skills: set[str],
    model: str | None,
    reasoning_effort: str | None,
    service_tier: str | None,
    codex_version: str | None = None,
) -> dict[str, Any]:
    return {
        "git_revision": git_revision(),
        "git_dirty_fingerprint": git_dirty_fingerprint(),
        "catalog_version": catalog_version(),
        "catalog_content_hash": catalog_content_hash(),
        "evaluation_case_hash": sha256_bytes(cases_path.read_bytes()),
        "codex_version": codex_version or detect_codex_version(),
        "model": model or "runtime-default",
        "reasoning_effort": reasoning_effort or "runtime-default",
        "service_tier": service_tier or "runtime-default",
        "codex_home_mode": "disposable",
        "skill_set": skill_set,
        "enabled_skill_count": len(enabled_skills),
        "enabled_skill_set_hash": stable_name_hash(enabled_skills),
    }


def build_run_plan(
    cases: list[dict[str, Any]], repetitions: int
) -> list[tuple[str, dict[str, Any]]]:
    return [
        (f"rep-{repetition}", case)
        for repetition in range(1, repetitions + 1)
        for case in cases
    ]


def prepare_disposable_codex_home(
    destination: Path,
    *,
    source: Path | None = None,
    trusted_project: Path,
) -> None:
    """Copy credentials and link skills into a controlled, disposable Codex home."""
    source = source or (Path.home() / ".codex")
    destination.mkdir(parents=True, exist_ok=True)
    auth = source / "auth.json"
    if auth.is_file():
        shutil.copy2(auth, destination / "auth.json")
    (destination / "config.toml").write_text(
        f"[projects.{json.dumps(str(trusted_project.resolve()))}]\n"
        'trust_level = "trusted"\n',
        encoding="utf-8",
    )
    destination_skills = destination / "skills"
    destination_skills.mkdir()
    source_skills = source / "skills"
    if source_skills.is_dir():
        for skill in sorted(source_skills.iterdir(), key=lambda path: path.name):
            if skill.is_dir():
                (destination_skills / skill.name).symlink_to(
                    skill.resolve(), target_is_directory=True
                )


def raise_codex_open_file_limit() -> None:
    """Give Codex enough descriptors to inspect the complete catalog on macOS."""
    if resource is None:
        return
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    target = 4096 if hard == resource.RLIM_INFINITY else min(4096, hard)
    if soft < target:
        resource.setrlimit(resource.RLIMIT_NOFILE, (target, hard))


def require_text(value: Any, field: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"{field} must be a non-empty string")
    return value.strip()


def require_safe_label(value: Any, field: str) -> str:
    label = require_text(value, field)
    if label in {".", ".."} or not SAFE_LABEL.fullmatch(label):
        raise ValueError(f"{field} must be a path-safe label")
    return label


def validate_cases(document: Any) -> list[dict[str, Any]]:
    if not isinstance(document, dict) or document.get("schema_version") != 1:
        raise ValueError("case document must use schema_version 1")
    cases = document.get("cases")
    if not isinstance(cases, list) or not cases:
        raise ValueError("case document must contain a non-empty cases list")

    seen: set[str] = set()
    for index, case in enumerate(cases):
        if not isinstance(case, dict):
            raise ValueError(f"case {index} must be an object")
        case_id = require_safe_label(case.get("id"), f"case {index} id")
        if case_id in seen:
            raise ValueError(f"duplicate case id: {case_id}")
        seen.add(case_id)
        if case.get("kind") not in {"route", "behavior"}:
            raise ValueError(f"case {case_id}: kind must be route or behavior")
        require_text(case.get("prompt"), f"case {case_id} prompt")
        require_text(case.get("expected_skill"), f"case {case_id} expected_skill")
        require_text(case.get("invoked_skill"), f"case {case_id} invoked_skill")
        runtimes = case.get("runtimes")
        if not isinstance(runtimes, list) or not runtimes:
            raise ValueError(f"case {case_id}: runtimes must be a non-empty list")
        unknown = set(runtimes) - SUPPORTED_RUNTIMES
        if unknown:
            raise ValueError(f"case {case_id}: unsupported runtime: {sorted(unknown)}")
        forbidden = case.get("forbidden_skills", [])
        if not isinstance(forbidden, list) or not all(
            isinstance(skill, str) and skill.strip() for skill in forbidden
        ):
            raise ValueError(f"case {case_id}: forbidden_skills must be a string list")
        if case["expected_skill"] in forbidden:
            raise ValueError(f"case {case_id}: expected_skill cannot be forbidden")
        assertions = case.get("assertions")
        if not isinstance(assertions, list) or not assertions:
            raise ValueError(f"case {case_id}: assertions must be a non-empty list")
        for assertion in assertions:
            if not isinstance(assertion, dict) or assertion.get("type") not in SUPPORTED_ASSERTIONS:
                raise ValueError(f"case {case_id}: unsupported assertion")
            require_text(assertion.get("value"), f"case {case_id} assertion value")
            if assertion["type"].startswith("file_"):
                require_text(assertion.get("path"), f"case {case_id} assertion path")
        fixture = case.get("fixture", {})
        if not isinstance(fixture, dict) or not all(
            isinstance(path, str) and isinstance(content, str)
            for path, content in fixture.items()
        ):
            raise ValueError(f"case {case_id}: fixture must map paths to text")
        if "allow_fixture_writes" in case and not isinstance(case["allow_fixture_writes"], bool):
            raise ValueError(f"case {case_id}: allow_fixture_writes must be Boolean")
    return cases


def load_cases(path: Path) -> list[dict[str, Any]]:
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"cannot load cases from {path}: {exc}") from exc
    return validate_cases(document)


def safe_fixture_path(workspace: Path, relative: str) -> Path:
    candidate = (workspace / relative).resolve()
    try:
        candidate.relative_to(workspace.resolve())
    except ValueError as exc:
        raise ValueError(f"fixture path escapes workspace: {relative}") from exc
    return candidate


def materialize_fixture(case: dict[str, Any], workspace: Path) -> None:
    for relative, content in case.get("fixture", {}).items():
        path = safe_fixture_path(workspace, relative)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")


def grade_output(
    case: dict[str, Any], output: str, workspace: Path | None = None
) -> dict[str, Any]:
    evidence = []
    passed_count = 0
    for assertion in case["assertions"]:
        assertion_type = assertion["type"]
        expected = assertion["value"]
        if assertion_type == "contains":
            passed = expected.casefold() in output.casefold()
            observed = "present" if passed else "missing"
        elif assertion_type == "not_contains":
            passed = expected.casefold() not in output.casefold()
            observed = "absent" if passed else "present"
        else:
            path = safe_fixture_path(workspace, assertion["path"]) if workspace else None
            actual = path.read_text(encoding="utf-8") if path and path.is_file() else None
            if assertion_type == "file_contains":
                passed = actual is not None and expected in actual
            else:
                passed = actual == expected
            observed = str(path) if actual is not None else "missing file"
        passed_count += int(passed)
        evidence.append({
            "type": assertion_type,
            "value": expected,
            "passed": passed,
            "observed": observed,
        })

    expected_skill = case["expected_skill"]
    selection = USE_SELECTION.search(output)
    selected_skill = selection.group(1) if selection else None
    if selected_skill is None and expected_skill.casefold() in output.casefold():
        selected_skill = expected_skill
    if case["kind"] == "route":
        route_passed = selected_skill == expected_skill
        passed_count += int(route_passed)
        evidence.append({
            "type": "expected_skill",
            "value": expected_skill,
            "passed": route_passed,
            "observed": selected_skill or "missing",
        })
    for forbidden_skill in case.get("forbidden_skills", []):
        forbidden_unselected = selected_skill != forbidden_skill
        passed_count += int(forbidden_unselected)
        evidence.append({
            "type": "forbidden_skill",
            "value": forbidden_skill,
            "passed": forbidden_unselected,
            "observed": selected_skill or "no structured selection",
        })
    denominator = len(evidence)
    return {
        "score": passed_count / denominator,
        "passed": passed_count == denominator,
        "selected_skill": selected_skill,
        "assertions": evidence,
    }


def render_prompt(case: dict[str, Any], runtime: str) -> str:
    prefix = "$" if runtime == "codex" else "/"
    invocation = prefix + case["invoked_skill"]
    return case["prompt"].replace("{invoke}", invocation)


def codex_skill_config(
    enabled_skills: set[str],
    all_live_skills: set[str],
    *,
    installed_root: Path | None = None,
) -> str:
    installed = installed_root or (Path.home() / ".codex" / "skills")
    entries = []
    for name in sorted(all_live_skills):
        installed_path = installed / name / "SKILL.md"
        path = installed_path if installed_path.is_file() else ROOT / "skills" / name / "SKILL.md"
        entries.append(
            "{path=" + json.dumps(str(path))
            + ",enabled=" + ("true" if name in enabled_skills else "false") + "}"
        )
    return "skills.config=[" + ",".join(entries) + "]"


def runtime_command(
    runtime: str,
    workspace: Path,
    prompt: str,
    *,
    allow_writes: bool,
    skill_set: str = "installed",
    enabled_skills: set[str] | None = None,
    all_live_skills: set[str] | None = None,
    model: str | None = None,
    reasoning_effort: str | None = None,
    service_tier: str | None = None,
    installed_skills_root: Path | None = None,
) -> list[str]:
    skills_dir = ROOT / "skills"
    if runtime == "codex":
        sandbox = "workspace-write" if allow_writes else "read-only"
        command = [
            "codex", "exec", "--ephemeral", "-s", sandbox,
            "-c", 'approval_policy="never"',
            "-c", "sandbox_workspace_write.network_access=false", "--json",
            "--skip-git-repo-check", "--add-dir", str(skills_dir), "-C",
            str(workspace),
        ]
        if model:
            command.extend(["-m", model])
        if reasoning_effort:
            command.extend(["-c", f"model_reasoning_effort={json.dumps(reasoning_effort)}"])
        if service_tier:
            command.extend(["-c", f"service_tier={json.dumps(service_tier)}"])
        if skill_set != "installed":
            if enabled_skills is None or all_live_skills is None:
                raise ValueError("controlled Codex skill sets require enabled and live skill names")
            command.extend([
                "-c",
                codex_skill_config(
                    enabled_skills,
                    all_live_skills,
                    installed_root=installed_skills_root,
                ),
            ])
        command.append(prompt)
        return command
    permission_mode = "acceptEdits"
    tool_list = "Read,Glob,Grep,Bash,Edit,Write" if allow_writes else "Read,Glob,Grep,Bash"
    installed_skills_dir = Path.home() / ".claude" / "skills"
    command = [
        "claude", "-p", "--output-format", "json", "--no-session-persistence",
        "--permission-mode", permission_mode, "--add-dir", str(skills_dir),
        "--add-dir", str(installed_skills_dir),
        "--tools", tool_list,
        "--disallowedTools", "WebFetch,WebSearch",
    ]
    if model:
        command.extend(["--model", model])
    command.extend([
        "--", prompt,
    ])
    return command


def extract_agent_text(runtime: str, stdout: str) -> str:
    if runtime == "claude":
        try:
            payload = json.loads(stdout)
        except json.JSONDecodeError:
            return stdout
        result = payload.get("result") if isinstance(payload, dict) else None
        return result if isinstance(result, str) else stdout

    messages = []
    for line in stdout.splitlines():
        try:
            payload = json.loads(line)
        except json.JSONDecodeError:
            continue
        item = payload.get("item") if isinstance(payload, dict) else None
        if isinstance(item, dict) and item.get("type") == "agent_message":
            text = item.get("text")
            if isinstance(text, str):
                messages.append(text)
    return messages[-1] if messages else stdout


def extract_runtime_metrics(runtime: str, stdout: str) -> dict[str, Any]:
    metrics: dict[str, Any] = {"model": None, "usage": {}, "cost_usd": None, "warnings": []}
    if runtime == "claude":
        try:
            payload = json.loads(stdout)
        except json.JSONDecodeError:
            return metrics
        if not isinstance(payload, dict):
            return metrics
        usage = payload.get("usage")
        if isinstance(usage, dict):
            metrics["usage"] = usage
        cost = payload.get("total_cost_usd")
        if isinstance(cost, (int, float)) and not isinstance(cost, bool):
            metrics["cost_usd"] = float(cost)
        model_usage = payload.get("modelUsage")
        if isinstance(model_usage, dict) and model_usage:
            first_name, first_value = next(iter(model_usage.items()))
            if isinstance(first_value, dict):
                metrics["model"] = first_value.get("canonicalModel") or first_name
            else:
                metrics["model"] = first_name
        return metrics

    for line in stdout.splitlines():
        try:
            payload = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(payload, dict):
            continue
        if payload.get("type") == "turn.completed" and isinstance(payload.get("usage"), dict):
            metrics["usage"] = payload["usage"]
        top_level_message = payload.get("message") if payload.get("type") == "error" else None
        if isinstance(top_level_message, str) and top_level_message not in metrics["warnings"]:
            metrics["warnings"].append(top_level_message)
        turn_error = payload.get("error") if payload.get("type") == "turn.failed" else None
        if isinstance(turn_error, dict):
            turn_message = turn_error.get("message")
            if isinstance(turn_message, str) and turn_message not in metrics["warnings"]:
                metrics["warnings"].append(turn_message)
        item = payload.get("item")
        if isinstance(item, dict) and item.get("type") == "error":
            message = item.get("message")
            if isinstance(message, str) and message and message not in metrics["warnings"]:
                metrics["warnings"].append(message)
    return metrics


def run_case(
    case: dict[str, Any],
    runtime: str,
    variant: str,
    raw_dir: Path,
    timeout: int,
    *,
    run_id: str = "rep-1",
    skill_set: str = "installed",
    enabled_skills: set[str] | None = None,
    all_live_skills: set[str] | None = None,
    model: str | None = None,
    reasoning_effort: str | None = None,
    service_tier: str | None = None,
    provenance: dict[str, Any] | None = None,
) -> dict[str, Any]:
    started = time.monotonic()
    with (
        tempfile.TemporaryDirectory(prefix=f"skill-eval-{case['id']}-") as directory,
        tempfile.TemporaryDirectory(prefix="skill-eval-codex-home-") as codex_home_directory,
    ):
        workspace = Path(directory)
        process_env = None
        installed_skills_root = None
        if runtime == "codex":
            codex_home = Path(codex_home_directory)
            prepare_disposable_codex_home(codex_home, trusted_project=workspace)
            process_env = {**os.environ, "CODEX_HOME": str(codex_home)}
            installed_skills_root = codex_home / "skills"
        materialize_fixture(case, workspace)
        prompt = render_prompt(case, runtime)
        command = runtime_command(
            runtime,
            workspace,
            prompt,
            allow_writes=bool(case.get("allow_fixture_writes")),
            skill_set=skill_set,
            enabled_skills=enabled_skills,
            all_live_skills=all_live_skills,
            model=model,
            reasoning_effort=reasoning_effort,
            service_tier=service_tier,
            installed_skills_root=installed_skills_root,
        )
        error = None
        try:
            completed = subprocess.run(
                command,
                cwd=workspace,
                text=True,
                capture_output=True,
                timeout=timeout,
                check=False,
                env=process_env,
                preexec_fn=raise_codex_open_file_limit if runtime == "codex" else None,
            )
            stdout, stderr, returncode = completed.stdout, completed.stderr, completed.returncode
        except subprocess.TimeoutExpired as exc:
            stdout = exc.stdout or ""
            stderr = exc.stderr or ""
            returncode = 124
            error = "timeout"

        raw_dir.mkdir(parents=True, exist_ok=True)
        raw_path = raw_dir / f"{runtime}-{run_id}-{case['id']}.json"
        raw_path.write_text(json.dumps({
            "runtime": runtime,
            "case_id": case["id"],
            "command": command[:-1] + ["<prompt>"],
            "prompt": prompt,
            "stdout": stdout,
            "stderr": stderr,
            "returncode": returncode,
        }, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")

        text = extract_agent_text(runtime, stdout)
        metrics = extract_runtime_metrics(runtime, stdout)
        grade = grade_output(case, text, workspace)
        if returncode != 0:
            grade["passed"] = False
            grade["score"] = 0.0
            error = error or f"exit_{returncode}"
        return {
            "case_id": case["id"],
            "run_id": run_id,
            "variant": variant,
            "category": case["kind"],
            "runtime": runtime,
            "expected_skill": case["expected_skill"],
            "selected_skill": grade["selected_skill"],
            "score": grade["score"],
            "passed": grade["passed"],
            "latency_ms": round((time.monotonic() - started) * 1000),
            "model": metrics["model"] or model or "runtime-default",
            "reported_model": metrics["model"],
            "usage": metrics["usage"],
            "cost_usd": metrics["cost_usd"],
            "runtime_warnings": metrics["warnings"],
            "error": error,
            "assertions": grade["assertions"],
            "raw_result": str(raw_path.relative_to(ROOT)),
            **(provenance or {}),
        }


def summarize_records(records: list[dict[str, Any]]) -> dict[str, Any]:
    by_runtime: dict[str, dict[str, int | float]] = defaultdict(
        lambda: {"total": 0, "passed": 0, "score_sum": 0.0}
    )
    for record in records:
        runtime = str(record.get("runtime", "unknown"))
        by_runtime[runtime]["total"] += 1
        by_runtime[runtime]["passed"] += int(record.get("passed") is True)
        by_runtime[runtime]["score_sum"] += float(record.get("score", 0.0))
    slices = {}
    for runtime, values in sorted(by_runtime.items()):
        total = int(values["total"])
        slices[runtime] = {
            "total": total,
            "passed": int(values["passed"]),
            "pass_rate": int(values["passed"]) / total if total else None,
            "mean_score": float(values["score_sum"]) / total if total else None,
        }
    return {
        "schema_version": 1,
        "total_records": len(records),
        "passed_records": sum(record.get("passed") is True for record in records),
        "by_runtime": slices,
        "scope": "Descriptive evidence from the supplied records; not a statistical or safety certification.",
    }


def is_context_truncation_warning(message: Any) -> bool:
    if not isinstance(message, str):
        return False
    normalized = message.casefold()
    return (
        "skill" in normalized
        and any(token in normalized for token in ("context budget", "shortened", "truncat"))
    )


def candidate_summary(records: list[dict[str, Any]]) -> dict[str, Any]:
    categories = {
        category: {
            "total": sum(record.get("category") == category for record in records),
            "passed": sum(
                record.get("category") == category and record.get("passed") is True
                for record in records
            ),
        }
        for category in ("route", "behavior")
    }
    for values in categories.values():
        values["pass_rate"] = values["passed"] / values["total"] if values["total"] else None
    selection_errors = [
        {
            "run_id": record.get("run_id"),
            "case_id": record.get("case_id"),
            "expected_skill": record.get("expected_skill"),
            "selected_skill": record.get("selected_skill"),
        }
        for record in records
        if record.get("category") == "route"
        and record.get("selected_skill") != record.get("expected_skill")
    ]
    warnings = [
        warning
        for record in records
        for warning in record.get("runtime_warnings", [])
        if isinstance(warning, str)
    ]
    input_tokens = [
        record.get("usage", {}).get("input_tokens")
        for record in records
        if isinstance(record.get("usage"), dict)
        and isinstance(record.get("usage", {}).get("input_tokens"), (int, float))
    ]
    latencies = [
        record.get("latency_ms")
        for record in records
        if isinstance(record.get("latency_ms"), (int, float))
    ]
    repetitions: dict[str, dict[str, int]] = {}
    for record in records:
        run_id = str(record.get("run_id", "unknown"))
        values = repetitions.setdefault(
            run_id,
            {"routing_total": 0, "routing_passed": 0, "behavior_total": 0, "behavior_passed": 0},
        )
        category = record.get("category")
        if category == "route":
            values["routing_total"] += 1
            values["routing_passed"] += int(record.get("passed") is True)
        elif category == "behavior":
            values["behavior_total"] += 1
            values["behavior_passed"] += int(record.get("passed") is True)
    return {
        "records": len(records),
        "routing": categories["route"],
        "behavior": categories["behavior"],
        "repetitions": dict(sorted(repetitions.items())),
        "skill_selection_errors": selection_errors,
        "runtime_warning_count": len(warnings),
        "context_truncation_warning_count": sum(
            is_context_truncation_warning(warning) for warning in warnings
        ),
        "infrastructure_failure_count": sum(bool(record.get("error")) for record in records),
        "input_tokens_total": sum(input_tokens) if input_tokens else None,
        "input_tokens_observed_records": len(input_tokens),
        "latency_ms_total": sum(latencies) if latencies else None,
        "latency_ms_mean": sum(latencies) / len(latencies) if latencies else None,
    }


def compare_result_sets(
    first: list[dict[str, Any]], second: list[dict[str, Any]]
) -> dict[str, Any]:
    candidates: dict[str, list[dict[str, Any]]] = {}
    for records in (first, second):
        names = {record.get("skill_set") for record in records}
        if len(names) != 1 or None in names:
            raise ValueError("each result set must contain exactly one skill_set")
        name = str(next(iter(names)))
        if name in candidates:
            raise ValueError(f"duplicate result skill_set: {name}")
        candidates[name] = records
    required = {"full-live", "hub-spine"}
    if set(candidates) != required:
        raise ValueError("compare requires one full-live and one hub-spine result set")

    full = candidates["full-live"]
    reduced = candidates["hub-spine"]
    for field in COMPARISON_PROVENANCE_FIELDS:
        full_values = {record.get(field) for record in full}
        reduced_values = {record.get(field) for record in reduced}
        if len(full_values) != 1 or len(reduced_values) != 1 or full_values != reduced_values:
            raise ValueError(
                f"compare requires matched provenance for {field}: "
                f"full-live={sorted(map(str, full_values))}, "
                f"hub-spine={sorted(map(str, reduced_values))}"
            )
    full_trials = {
        (record.get("run_id"), record.get("case_id"), record.get("category"))
        for record in full
    }
    reduced_trials = {
        (record.get("run_id"), record.get("case_id"), record.get("category"))
        for record in reduced
    }
    if full_trials != reduced_trials:
        raise ValueError("compare requires matched provenance for trial identities")

    summaries = {
        "full-live": candidate_summary(full),
        "hub-spine": candidate_summary(reduced),
    }
    routing_gain = (
        summaries["hub-spine"]["routing"]["passed"]
        - summaries["full-live"]["routing"]["passed"]
    )
    full_repetitions = summaries["full-live"]["repetitions"]
    reduced_repetitions = summaries["hub-spine"]["repetitions"]
    common_repetitions = sorted(set(full_repetitions) & set(reduced_repetitions))
    improved_repetitions = sum(
        reduced_repetitions[run_id]["routing_passed"]
        > full_repetitions[run_id]["routing_passed"]
        for run_id in common_repetitions
    )

    full_behavior = {
        (record.get("run_id"), record.get("case_id")): record
        for record in full if record.get("category") == "behavior"
    }
    reduced_only_failures = []
    for record in reduced:
        if record.get("category") != "behavior" or record.get("passed") is True:
            continue
        key = (record.get("run_id"), record.get("case_id"))
        baseline = full_behavior.get(key)
        if baseline and baseline.get("passed") is True:
            reduced_only_failures.append({"run_id": key[0], "case_id": key[1]})

    trial_count_warnings = []
    for name, summary in summaries.items():
        if summary["routing"]["total"] != 18:
            trial_count_warnings.append(
                f"{name} has {summary['routing']['total']} routing trials; expected 18"
            )
        if summary["behavior"]["total"] != 12:
            trial_count_warnings.append(
                f"{name} has {summary['behavior']['total']} behavior trials; expected 12"
            )
    recommend = (
        routing_gain >= 2
        and improved_repetitions >= 2
        and not reduced_only_failures
        and not trial_count_warnings
        and summaries["full-live"]["infrastructure_failure_count"] == 0
        and summaries["hub-spine"]["infrastructure_failure_count"] == 0
    )
    return {
        "schema_version": 1,
        "candidates": summaries,
        "routing_gain": routing_gain,
        "improved_repetitions": improved_repetitions,
        "compared_repetitions": common_repetitions,
        "reduced_only_behavior_failures": reduced_only_failures,
        "trial_count_warnings": trial_count_warnings,
        "recommend_selectable_profiles": recommend,
        "recommendation": (
            "recommend selectable profiles"
            if recommend
            else "do not recommend selectable profiles from this evidence"
        ),
        "decision_rule": {
            "minimum_additional_routing_successes": 2,
            "minimum_improved_repetitions": 2,
            "maximum_reduced_only_behavior_failures": 0,
        },
        "scope": (
            "Routing and behavior determine the recommendation; warning, token, and latency "
            "differences are operational evidence only."
        ),
    }


def read_jsonl(path: Path) -> list[dict[str, Any]]:
    records = []
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        if not line.strip():
            continue
        value = json.loads(line)
        if not isinstance(value, dict):
            raise ValueError(f"line {number}: result must be an object")
        records.append(value)
    return records


def scratch_output(path: Path) -> Path:
    resolved = path.resolve()
    scratch = (ROOT / ".scratch").resolve()
    try:
        resolved.relative_to(scratch)
    except ValueError as exc:
        raise ValueError("live result output must be under repository .scratch/") from exc
    return resolved


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    validate = subparsers.add_parser("validate")
    validate.add_argument("cases", type=Path)

    run = subparsers.add_parser("run")
    run.add_argument("--runtime", choices=sorted(SUPPORTED_RUNTIMES), required=True)
    run.add_argument("--cases", type=Path, required=True)
    run.add_argument("--case", action="append", dest="case_ids")
    run.add_argument("--all", action="store_true")
    run.add_argument("--variant", required=True)
    run.add_argument("--output", type=Path, required=True)
    run.add_argument("--timeout", type=int, default=180)
    run.add_argument("--skill-set", choices=sorted(SUPPORTED_SKILL_SETS), default="installed")
    run.add_argument("--repetitions", type=int, default=1)
    run.add_argument("--model")
    run.add_argument("--reasoning-effort")
    run.add_argument("--service-tier", default="default")
    run.add_argument("--execute", action="store_true", help="confirm provider-backed execution")
    run.add_argument("--overwrite", action="store_true")

    summarize = subparsers.add_parser("summarize")
    summarize.add_argument("results", type=Path)

    compare = subparsers.add_parser("compare")
    compare.add_argument("first", type=Path)
    compare.add_argument("second", type=Path)

    args = parser.parse_args(argv)
    if args.command == "validate":
        cases = load_cases(args.cases)
        print(json.dumps({"schema_version": 1, "valid": True, "case_count": len(cases)}))
        return 0
    if args.command == "summarize":
        print(json.dumps(summarize_records(read_jsonl(args.results)), indent=2, sort_keys=True))
        return 0
    if args.command == "compare":
        try:
            comparison = compare_result_sets(read_jsonl(args.first), read_jsonl(args.second))
        except (OSError, json.JSONDecodeError, ValueError) as exc:
            parser.error(str(exc))
        print(json.dumps(comparison, indent=2, sort_keys=True))
        return 0

    if not args.execute:
        parser.error("run requires --execute because it invokes a provider-backed agent runtime")
    try:
        require_safe_label(args.variant, "variant")
    except ValueError as exc:
        parser.error(str(exc))
    if args.timeout <= 0:
        parser.error("--timeout must be greater than zero")
    if args.repetitions <= 0:
        parser.error("--repetitions must be greater than zero")
    if args.runtime != "codex" and args.skill_set != "installed":
        parser.error("controlled --skill-set candidates are supported only for Codex")
    if args.all == bool(args.case_ids):
        parser.error("run requires exactly one of --all or one-or-more --case values")
    if shutil.which(args.runtime) is None:
        parser.error(f"runtime not installed: {args.runtime}")
    output = scratch_output(args.output)
    if output.exists() and not args.overwrite:
        parser.error(f"output exists; pass --overwrite to replace it: {output}")
    cases = [case for case in load_cases(args.cases) if args.runtime in case["runtimes"]]
    if args.case_ids:
        selected = set(args.case_ids)
        known = {case["id"] for case in cases}
        unknown = selected - known
        if unknown:
            parser.error(f"unknown or runtime-inapplicable cases: {sorted(unknown)}")
        cases = [case for case in cases if case["id"] in selected]
    if not cases:
        parser.error(f"no cases apply to runtime: {args.runtime}")
    try:
        enabled_skills = derive_skill_set(args.skill_set)
    except ValueError as exc:
        parser.error(str(exc))
    all_live_skills = live_skill_names()
    provenance = build_provenance(
        cases_path=args.cases,
        skill_set=args.skill_set,
        enabled_skills=enabled_skills,
        model=args.model,
        reasoning_effort=args.reasoning_effort,
        service_tier=args.service_tier,
    )
    output.parent.mkdir(parents=True, exist_ok=True)
    raw_dir = output.parent / "raw" / args.variant / args.skill_set
    records = [
        run_case(
            case,
            args.runtime,
            args.variant,
            raw_dir,
            args.timeout,
            run_id=run_id,
            skill_set=args.skill_set,
            enabled_skills=enabled_skills,
            all_live_skills=all_live_skills,
            model=args.model,
            reasoning_effort=args.reasoning_effort,
            service_tier=args.service_tier,
            provenance=provenance,
        )
        for run_id, case in build_run_plan(cases, args.repetitions)
    ]
    output.write_text(
        "".join(json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n" for record in records),
        encoding="utf-8",
    )
    print(json.dumps(summarize_records(records), indent=2, sort_keys=True))
    return 0 if all(record["passed"] for record in records) else 1


if __name__ == "__main__":
    raise SystemExit(main())
